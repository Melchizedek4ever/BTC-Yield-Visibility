# Secondary gate. Vercel runs `npm run verify` before every build and reports
# the result on the PR, so this is a redundant net rather than the only one —
# which is why an Actions outage is survivable.
name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  ci:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - run: npm ci
      # The same gate Vercel runs before every build and the pre-push hook runs
      # before every push. One script, three callers, so they cannot drift.
      - run: npm run verify
      # Lint, types and tests all pass on a tree that does not compile. The
      # build is the only step that proves the app can actually ship.
      - run: npm run build
