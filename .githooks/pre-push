#!/bin/sh
# Local pre-push gate — runs the same `npm run verify` that Vercel runs before
# every build, so a red build never leaves the machine. Both call the one script
# rather than restating its steps, which is what stops them drifting apart.
#
# Also refuses direct pushes to main — every change lands through a PR.
#
# Git cannot self-install hooks, so this needs one command per clone:
#   git config core.hooksPath .githooks
# Bypass in a real emergency:  git push --no-verify

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "pre-push: direct pushes to main are blocked — open a PR instead." >&2
      exit 1
      ;;
  esac
done

echo "pre-push: running the quality gate..."
npm run verify || exit 1
